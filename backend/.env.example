# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=traceiq_db
MONGODB_SOURCE_COLLECTION=sources
MONGODB_CHUNK_COLLECTION=chunks
MONGODB_VECTOR_INDEX=traceiq_vector_index

# Embeddings and grounded answer generation
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Ingestion and retrieval settings
DATASET_DIR=
CHUNK_SIZE=1000
CHUNK_OVERLAP=120
RETRIEVAL_CANDIDATE_LIMIT=30
FINAL_EVIDENCE_LIMIT=10
MAX_SOURCE_FILE_BYTES=26214400
REQUEST_TIMEOUT_SECONDS=30

# Application settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
