# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=traceiq_db
MONGODB_SOURCE_COLLECTION=sources
MONGODB_CHUNK_COLLECTION=chunks
MONGODB_VECTOR_INDEX=traceiq_vector_index
MONGODB_SEARCH_INDEX=traceiq_search_index

# Embeddings and grounded answer generation
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=64
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_MAX_BACKOFF_SECONDS=8
GEMINI_RETRY_BUDGET_SECONDS=20

# Ingestion and retrieval settings
DATASET_DIR=
CHUNK_SIZE=500
CHUNK_OVERLAP=60
RETRIEVAL_CANDIDATE_LIMIT=30
FINAL_EVIDENCE_LIMIT=10
MAX_SOURCE_FILE_BYTES=26214400
REQUEST_TIMEOUT_SECONDS=30
SEARCH_INDEX_TIMEOUT_SECONDS=90

# Application settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVICE_OWNERS={"payment-service": "Payments Team", "order-service": "Orders Team"}
IMAGE_ANALYSIS_ENABLED=true
